# Application name and slug. APP_NAME is the single source of the bot's name (/start, logs, playground).
APP_NAME="My Bot"
APP_SLUG=my-bot

# Telegram bot token from @BotFather (https://t.me/BotFather). Keep it secret; never commit .env.
# Empty: `dev` runs only the local playground. Use a separate bot for development.
BOT_TOKEN=

# Bot API server. Empty: Telegram's (https://api.telegram.org); set it for a self-hosted server.
TELEGRAM_API_URL=

# How the running bot (`start`, Docker) receives updates: polling | webhook.
# Development (`dev`) always uses long polling.
BOT_MODE=polling

# The bot's HTTP server: GET /health, and the webhook endpoint in webhook mode.
# Use 0.0.0.0 to accept connections from other hosts.
APP_HOST=localhost
APP_PORT=8080

# Webhook mode: the public https:// address that forwards to APP_PORT, the path Telegram posts to,
# and the secret Telegram sends in the X-Telegram-Bot-Api-Secret-Token header.
WEBHOOK_BASE_URL=
WEBHOOK_PATH=/telegram/webhook
WEBHOOK_SECRET=

# Local chat with the bot in the browser (`dev` only; nothing is sent to Telegram).
PLAYGROUND_HOST=localhost
PLAYGROUND_PORT=8090

# SQLite database file, relative to the project root.
DB_PATH=data/my-bot.sqlite

# CRITICAL | ERROR | WARNING | INFO | DEBUG
LOG_LEVEL=INFO
